# Gateway
# Change both secrets before exposing this process beyond your laptop.
LLMGATE_DATABASE_URL=postgresql+asyncpg://llmgate:llmgate@postgres:5432/llmgate
LLMGATE_REDIS_URL=redis://redis:6379/0
LLMGATE_MASTER_KEY=dev-master-key-change-me
LLMGATE_KEY_PEPPER=dev-pepper-change-me
LLMGATE_MODELS_PATH=config/models.yaml
LLMGATE_LOG_LEVEL=INFO
LLMGATE_REQUEST_TIMEOUT_SECONDS=300

# Provider credentials. The gateway reads these from the environment.
# They are never accepted from client requests.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# From inside Compose, the host Ollama daemon is host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
